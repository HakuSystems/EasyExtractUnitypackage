<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EasyExtractCrossPlatform.ViewModels"
        x:Class="EasyExtractCrossPlatform.DuplicateFinderWindow"
        x:DataType="vm:DuplicateFinderViewModel"
        Title="Duplicate finder"
        Width="1000"
        Height="740"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        TransparencyLevelHint="AcrylicBlur"
        Foreground="{DynamicResource EasyTextColorBrush}"
        Background="{DynamicResource EasyWindowBackgroundBrush}">
    <Window.Styles>
        <Style Selector="Border.duplicate-card">
            <Setter Property="Background" Value="{DynamicResource EasyGlassGradientBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EasyGlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="24" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource EasyMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.headline">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.wasted">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource EasyAccentBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Classes="duplicate-card" Margin="24,24,24,12">
            <StackPanel Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Classes="headline" Text="{Binding SummaryHeadline}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SummaryDetail}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <TextBox Grid.Column="0"
                             IsReadOnly="True"
                             VerticalAlignment="Center"
                             PlaceholderText="No folder selected"
                             Text="{Binding LibraryPath, Mode=OneWay}" />
                    <Button Grid.Column="1"
                            Name="ChooseFolderButton"
                            Content="Choose folder"
                            IsEnabled="{Binding IsIdle}"
                            Click="ChooseFolderButton_OnClick" />
                    <Button Grid.Column="2"
                            Name="RescanButton"
                            Content="Rescan"
                            IsEnabled="{Binding HasLibraryPath}"
                            Click="RescanButton_OnClick" />
                </Grid>

                <StackPanel Spacing="8" IsVisible="{Binding IsScanning}">
                    <ProgressBar Minimum="0" Maximum="100" Height="6"
                                 Value="{Binding ProgressPercent, Mode=OneWay}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="muted" Text="{Binding ProgressText}" />
                        <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" />
                    </Grid>
                </StackPanel>

                <TextBlock Classes="muted"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasStatusMessage}"
                           Text="{Binding StatusMessage}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="duplicate-card" Margin="24,0,24,12"
                IsVisible="{Binding ShowEmptyState}">
            <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="Nothing stored twice" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Every asset in this folder appears exactly once. Nothing to clean up." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="24,0,24,24" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding HasFindings}">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DuplicateGroupDisplay">
                        <Expander Margin="0,0,0,12" HorizontalAlignment="Stretch">
                            <Expander.Header>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding AssetName}" />
                                        <TextBlock Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding AssetPath}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                        <TextBlock Classes="wasted" HorizontalAlignment="Right"
                                                   Text="{Binding WastedText}" />
                                        <TextBlock Classes="muted" FontSize="12" HorizontalAlignment="Right"
                                                   Text="{Binding CopiesText}" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <TextBlock Classes="muted" FontSize="12">
                                    <Run Text="{Binding SizeText, Mode=OneWay}" />
                                    <Run Text="each," />
                                    <Run Text="{Binding ScopeText, Mode=OneWay}" />
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Occurrences}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DuplicateOccurrenceDisplay">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,4">
                                                <TextBlock Grid.Column="0" FontWeight="SemiBold"
                                                           Text="{Binding PackageLabel}" />
                                                <TextBlock Grid.Column="1" Classes="muted" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding AssetPath}"
                                                           ToolTip.Tip="{Binding PackagePath}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
