<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light variant of the website palette: the white of the logo's cloud as the
         surface, the box grey for text and lines, a darker turquoise for text so it
         stays readable. Primary buttons keep the logo turquoise with dark text. -->
    <SolidColorBrush x:Key="EasyWindowBackgroundBrush" Color="#F4F4F4" />

    <SolidColorBrush x:Key="EasyTextColorBrush" Color="#161616" />
    <SolidColorBrush x:Key="EasyMutedBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="EasyPrimaryBrush" Color="#155980" />
    <SolidColorBrush x:Key="EasyAccentBrush" Color="#037A6D" />
    <SolidColorBrush x:Key="EasyOnPrimaryBrush" Color="#161616" />
    <SolidColorBrush x:Key="EasyOnAccentBrush" Color="#032A26" />
    <SolidColorBrush x:Key="EasyAccentHoverBrush" Color="#1CDCC8" />
    <SolidColorBrush x:Key="EasySurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="EasyStrokeBrush" Color="#DCDCDC" />

    <SolidColorBrush x:Key="EasyGlassGradientBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="EasyButtonBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="EasyButtonHoverBrush" Color="#EBEBEB" />

    <SolidColorBrush x:Key="EasyGlassBorderBrush" Color="#DCDCDC" />
    <SolidColorBrush x:Key="EasyGlassNeutralBorderBrush" Color="#DCDCDC" />
    <SolidColorBrush x:Key="EasyGlassStrongBorderBrush" Color="#B8B8B8" />
    <SolidColorBrush x:Key="EasyGlassDisabledBorderBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="EasyGlassOverlayFaintBrush" Color="#06000000" />
    <SolidColorBrush x:Key="EasyGlassOverlayBrush" Color="#0D000000" />
    <SolidColorBrush x:Key="EasyGlassOverlayStrongBrush" Color="#17000000" />
    <SolidColorBrush x:Key="EasyGlassMutedBrush" Color="#666666" />

    <SolidColorBrush x:Key="EasyAccentSoftBrush" Color="#1A037A6D" />
    <SolidColorBrush x:Key="EasyAccentStrongBrush" Color="#2E037A6D" />

    <SolidColorBrush x:Key="EasyWarningBrush" Color="#FF9A6400" />
    <SolidColorBrush x:Key="EasyDangerOverlayBrush" Color="#14D11F3D" />
    <SolidColorBrush x:Key="EasyDangerBorderBrush" Color="#FFD11F3D" />
    <SolidColorBrush x:Key="EasyDangerForegroundBrush" Color="#FFB11F36" />
</ResourceDictionary>
